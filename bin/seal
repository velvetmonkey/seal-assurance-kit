#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// seal assurance kit CLI.
//
// Exit codes (also in README "Exit codes"):
//   0  check passed (or help / version)
//   1  check ran and FAILED (NOT VERIFIED, FAIL, NON-CONFORMANT, collisions found)
//   2  usage error (unknown command / flag / profile, missing argument)
//   3  internal error (unexpected exception — not a verdict)
//   4  REDUCED SCOPE (valid evidence, but not eligible for PASS VERIFIED)
const path = require("path");
const readline = require("node:readline");

const KNOWN_PROFILES = ["L0"];

const HELP = [
  "seal assurance kit",
  "",
  "  seal verify <receipt.json> [--expected-config-pubkey <64-hex>]",
  "                                verify a decision receipt; principal-bearing",
  "                                receipts require this out-of-band operator pin",
  "  seal init <manifest.tools.json> [--out <policy.json>]",
  "  seal init --recipe <prod-db|deploy|token-governor|mesh> <manifest.tools.json> [--out <policy.json>]",
  "                                scaffold an exact-name reviewable policy",
  "  seal add-kernel <S|T|C|V|L|B> <manifest.tools.json> [--policy <policy.json>]",
  "                                add one non-vacuous kernel to an existing policy",
  "  seal add-kernel K <manifest.tools.json> [--policy <policy.json>] --experimental",
  "                                EXPERIMENTAL Calibration; never emitted by recipes",
  "  seal test   [--profile L0]    MCP boundary conformance oracle",
  "  seal scan   <tools> <policy>  MCP policy coverage auditor",
  "                                (FAIL + exit 1 = uncovered mutating tools found;",
  "                                 that is scan doing its job, not the kit breaking)",
  "  seal scan diff <old> <new> <policy>   what changed since last scan",
  "  seal adequacy check <labels>          finite monitor-resolution adequacy",
  "  seal adequacy find-collision <labels> find a semantic monitor collision",
  "  seal receipt-diff <A.json> <B.json> [--json]",
  "                                authorization-surface diff between two receipts:",
  "                                what changed, grouped AUTHORIZATION vs MINOR.",
  "                                (reports change only — does not re-verify a seal,",
  "                                 and does not judge field-set sufficiency)",
  "                                exit: 0 no auth drift · 1 drift · 2 malformed/",
  "                                legacy/tampered",
  "  seal policy sign <policy.json> --key <seed-file> [--out <trusted.json>] [--yes]",
  "                                validate and Ed25519-sign a policy envelope",
  "                                (accepts the full 7-kernel bundle: safety +",
  "                                 temporal/consensus/convergence/calibration/",
  "                                 linear/budget sections, per-section `enabled`;",
  "                                 unknown section/entry keys are refused exactly",
  "                                 where the verified kernel parser refuses them)",
  "  seal connect --client claude [--desktop] [--profile <profile.json>]",
  "  seal disconnect --client claude [--desktop]",
  "",
  "  --help, -h      this help",
  "  --version, -V   print the kit version",
  "",
  "  input formats: docs/SCHEMAS.md",
  "  exit codes: 0 pass · 1 failed · 2 usage · 3 internal · 4 reduced scope",
].join("\n");

function usageError(msg) {
  console.error(msg);
  console.error("run `seal --help` for usage");
  process.exit(2);
}

function confirm(question) {
  return new Promise((resolve) => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
    rl.question(question, (answer) => { rl.close(); resolve(answer.trim().toLowerCase() === "y"); });
  });
}

async function main() {
  const cmd = process.argv[2];
  if (!cmd || cmd === "--help" || cmd === "-h" || cmd === "help") {
    console.log(HELP);
    process.exit(0);
  }
  if (cmd === "--version" || cmd === "-V") {
    console.log(require(path.join(__dirname, "../package.json")).version);
    process.exit(0);
  }
  if (cmd === "verify") {
    const args = process.argv.slice(3);
    let f, expectedConfigPubkey;
    for (let index = 0; index < args.length; index++) {
      const arg = args[index];
      if (arg === "--expected-config-pubkey") {
        if (expectedConfigPubkey !== undefined)
          usageError("--expected-config-pubkey may be supplied only once");
        expectedConfigPubkey = args[++index];
        if (!expectedConfigPubkey)
          usageError("--expected-config-pubkey requires a 64-lowercase-hex Ed25519 public key");
      } else if (arg.startsWith("-") || f) {
        usageError("usage: seal verify <receipt.json> [--expected-config-pubkey <64-hex>]");
      } else f = arg;
    }
    if (!f) usageError("usage: seal verify <receipt.json> [--expected-config-pubkey <64-hex>]");
    if (expectedConfigPubkey !== undefined && !/^[0-9a-f]{64}$/.test(expectedConfigPubkey))
      usageError("--expected-config-pubkey requires a 64-lowercase-hex Ed25519 public key");
    const { verifyDetailed } = require(path.join(__dirname, "../src/verify.cjs"));
    const result = await verifyDetailed(path.resolve(f), { expectedConfigPubkey });
    process.exit(result.exitCode);
  }
  if (cmd === "init") {
    const args = process.argv.slice(3);
    let manifest, out, recipe;
    for (let index = 0; index < args.length; index++) {
      const arg = args[index];
      if (arg === "--out" || arg === "--recipe") {
        const value = args[++index];
        if (!value) usageError("usage: seal init [--recipe <name>] <manifest.tools.json> [--out <policy.json>]");
        if (arg === "--out") out = value;
        else recipe = value;
      } else if (arg.startsWith("--") || manifest) {
        usageError("usage: seal init [--recipe <name>] <manifest.tools.json> [--out <policy.json>]");
      } else manifest = arg;
    }
    if (!manifest) usageError("usage: seal init [--recipe <name>] <manifest.tools.json> [--out <policy.json>]");
    const { initPolicy } = require(path.join(__dirname, "../src/init.cjs"));
    try {
      const result = initPolicy(path.resolve(manifest), {
        outputPath: out ? path.resolve(out) : undefined,
        recipe,
      });
      console.log(`created policy  ${result.output}`);
      if (recipe) {
        const active = result.participation.active.map((entry) => entry.symbol).join(",");
        console.log(`recipe ${recipe}  ACTIVE {${active}}  PRESENT-BUT-INACTIVE {}`);
        for (const mapping of result.mappings)
          console.log(`  ${mapping.notice}`);
      }
      if (result.unverifiedAllows.length) {
        console.log(`WARNING  ${result.unverifiedAllows.length} unverified suggestion(s) — server self-described readOnly:`);
        for (const name of result.unverifiedAllows) console.log(`  ${name}`);
      }
      console.log("review every rule before signing; annotations are trusted input, not verification");
      process.exit(0);
    } catch (error) {
      console.error(`FAIL  ${error.message}`);
      process.exit(1);
    }
  }
  if (cmd === "add-kernel") {
    const symbol = process.argv[3];
    const manifest = process.argv[4];
    if (!symbol || !manifest)
      usageError("usage: seal add-kernel <S|T|C|V|L|B> <manifest.tools.json> [--policy <policy.json>] [--experimental for K]");
    const args = process.argv.slice(5);
    let policy;
    let experimental = false;
    for (let index = 0; index < args.length; index++) {
      const arg = args[index];
      if (arg === "--policy") {
        policy = args[++index];
        if (!policy) usageError("--policy requires a policy path");
      } else if (arg === "--experimental") experimental = true;
      else usageError(`unknown argument: ${arg}`);
    }
    const { addKernel } = require(path.join(__dirname, "../src/init.cjs"));
    try {
      if (String(symbol).toUpperCase() === "K")
        console.error("WARNING  CALIBRATION (K) IS EXPERIMENTAL and is outside every recommended recipe.");
      const result = addKernel(path.resolve(manifest), symbol, {
        policyPath: policy ? path.resolve(policy) : undefined,
        experimental,
      });
      console.log(`updated policy  ${result.output}`);
      console.log(`added kernel  ${result.section} (${result.symbol}) — ACTIVE`);
      for (const notice of result.notices) console.log(`  ${notice}`);
      console.log("review every EDIT-ME placeholder, then run seal policy sign and seal scan");
      process.exit(0);
    } catch (error) {
      console.error(`FAIL  ${error.message}`);
      process.exit(1);
    }
  }
  if (cmd === "policy") {
    if (process.argv[3] !== "sign" || !process.argv[4])
      usageError("usage: seal policy sign <policy.json> --key <seed-file> [--out <trusted.json>] [--yes]");
    const policy = process.argv[4];
    const args = process.argv.slice(5);
    const valueAfter = (flag) => {
      const index = args.indexOf(flag);
      return index >= 0 ? args[index + 1] : undefined;
    };
    const key = valueAfter("--key");
    const out = valueAfter("--out");
    const yes = args.includes("--yes");
    const known = new Set(["--key", "--out", "--yes", key, out].filter(Boolean));
    const unknown = args.find((arg) => !known.has(arg));
    if (!key || unknown)
      usageError("usage: seal policy sign <policy.json> --key <seed-file> [--out <trusted.json>] [--yes]");
    const { preparePolicy, signPreparedPolicy } = require(path.join(__dirname, "../src/policy-sign.cjs"));
    const { formatParticipation } = require(path.join(__dirname, "../src/trusted-config.cjs"));
    try {
      const prepared = preparePolicy(path.resolve(policy));
      console.error("EFFECTIVE KERNEL PARTICIPATION (signed payload):");
      for (const line of formatParticipation(prepared.participation)) console.error(`  ${line}`);
      const { guarded, allowUnverified, unknownGuarded } = prepared.summary;
      const warning = `${guarded} guarded, ${allowUnverified} allow(unverified), ${unknownGuarded} unknown→guarded — acknowledge effective participation and sign anyway? [y/N]`;
      console.error(`WARNING  ${warning}`);
      if (!yes) {
        if (!process.stdin.isTTY || !process.stderr.isTTY)
          throw new Error("signing confirmation requires an interactive TTY; use --yes for CI after review");
        if (!await confirm("> ")) throw new Error("signing cancelled; policy was not signed");
      } else {
        console.error("ACKNOWLEDGED  --yes supplied; signing the displayed policy summary");
      }
      const result = signPreparedPolicy(prepared, {
        keyPath: path.resolve(key), outputPath: out ? path.resolve(out) : undefined,
      });
      console.log(`signed policy  ${result.output}`);
      console.log(`  policy_hash=${result.policyHash}`);
      console.log(`  public_key=${result.publicKey}`);
      console.log(`  verify/run: seal-host-rs --config ${result.output} --pubkey ${result.publicKey} ...`);
      process.exit(0);
    } catch (error) {
      console.error(`FAIL  ${error.message}`);
      process.exit(1);
    }
  }
  if (cmd === "connect" || cmd === "disconnect") {
    const args = process.argv.slice(3);
    const clientIndex = args.indexOf("--client");
    const client = clientIndex >= 0 ? args[clientIndex + 1] : undefined;
    const desktop = args.includes("--desktop");
    if (client !== "claude") usageError(`usage: seal ${cmd} --client claude [--desktop]${cmd === "connect" ? " [--profile <profile.json>]" : ""}`);
    const profileIndex = args.indexOf("--profile");
    const profile = profileIndex >= 0 ? args[profileIndex + 1] : undefined;
    const consumed = new Set(["--client", "claude", "--desktop"]);
    if (profile) { consumed.add("--profile"); consumed.add(profile); }
    const unknown = args.find((arg) => !consumed.has(arg));
    if (unknown || (cmd === "disconnect" && profile))
      usageError(`usage: seal ${cmd} --client claude [--desktop]${cmd === "connect" ? " [--profile <profile.json>]" : ""}`);
    const integration = require(path.join(__dirname, "../src/connect.cjs"));
    try {
      const result = cmd === "connect"
        ? integration.connect({ profilePath: path.resolve(profile), desktop })
        : integration.disconnect({ desktop });
      console.log(`${result.message}: ${result.label}`);
      console.log(`  config: ${result.config}`);
      if (result.metadata) console.log(`  rollback record: ${result.metadata}`);
      console.log(`  rollback: seal disconnect --client claude${desktop ? " --desktop" : ""}`);
      console.log(desktop ? "  restart: fully quit and reopen Claude Desktop" : "  verify: claude mcp list, then /mcp");
      process.exit(0);
    } catch (error) {
      console.error(`FAIL  ${error.message}`);
      process.exit(1);
    }
  }
  if (cmd === "test") {
    let profile = "L0";
    const arg = process.argv[3];
    if (arg !== undefined) {
      if (arg === "--profile") {
        profile = process.argv[4];
        if (!profile) usageError("usage: seal test [--profile L0]");
      } else if (arg.startsWith("--profile=")) {
        profile = arg.slice("--profile=".length);
      } else {
        usageError(`unknown argument: ${arg}`);
      }
      if (!KNOWN_PROFILES.includes(profile)) {
        usageError(`unknown profile: ${JSON.stringify(profile)} (known: ${KNOWN_PROFILES.join(", ")})`);
      }
    }
    const { test } = require(path.join(__dirname, "../src/test.cjs"));
    const ok = await test(profile);
    process.exit(ok ? 0 : 1);
  }
  if (cmd === "scan") {
    const { scan, diff } = require(path.join(__dirname, "../src/scan.cjs"));
    if (process.argv[3] === "diff") {
      const [o, n, p] = process.argv.slice(4);
      if (!o || !n || !p) usageError("usage: seal scan diff <old-tools.json> <new-tools.json> <policy.json>");
      process.exit(diff(path.resolve(o), path.resolve(n), path.resolve(p)) ? 0 : 1);
    }
    const [t, p] = process.argv.slice(3);
    if (!t || !p) usageError("usage: seal scan <tools.json> <policy.json>");
    process.exit(scan(path.resolve(t), path.resolve(p)) ? 0 : 1);
  }
  if (cmd === "receipt-diff") {
    const args = process.argv.slice(3);
    const json = args.includes("--json");
    const files = args.filter((a) => !a.startsWith("--"));
    const bad = args.filter((a) => a.startsWith("--") && a !== "--json");
    if (bad.length) usageError(`unknown flag: ${bad[0]}`);
    if (files.length !== 2) usageError("usage: seal receipt-diff <A.json> <B.json> [--json]");
    const { receiptDiff } = require(path.join(__dirname, "../src/receipt-diff.cjs"));
    process.exit(await receiptDiff(path.resolve(files[0]), path.resolve(files[1]), { json }));
  }
  if (cmd === "adequacy") {
    const sub = process.argv[3];
    const f = process.argv[4];
    if (sub === "check") {
      if (!f) usageError("usage: seal adequacy check <labels.json>");
      const { check } = require(path.join(__dirname, "../src/adequacy.cjs"));
      process.exit(check(path.resolve(f)) ? 0 : 1);
    }
    if (sub === "find-collision") {
      if (!f) usageError("usage: seal adequacy find-collision <labels.json>");
      const { findCollision } = require(path.join(__dirname, "../src/adequacy.cjs"));
      process.exit(findCollision(path.resolve(f)) ? 0 : 1);
    }
    usageError("usage: seal adequacy check <labels.json> | seal adequacy find-collision <labels.json>");
  }
  usageError(`unknown command: ${cmd}`);
}

main().catch((e) => { console.error("ERR", e.message); process.exit(3); });
