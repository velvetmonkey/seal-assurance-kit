#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// seal assurance kit CLI. One binary, three commands: verify | test | scan.
const path = require("path");

async function main() {
  const cmd = process.argv[2];
  if (cmd === "verify") {
    const f = process.argv[3];
    if (!f) { console.error("usage: seal verify <receipt.json>"); process.exit(2); }
    const { verify } = require(path.join(__dirname, "../src/verify.cjs"));
    const ok = await verify(path.resolve(f));
    process.exit(ok ? 0 : 1);
  }
  if (cmd === "test") {
    console.log("seal test  — MCP boundary conformance oracle. Wires the seal-check L0 corpus next.");
    process.exit(2);
  }
  if (cmd === "scan") {
    console.log("seal scan  — MCP policy coverage auditor (tools/list -> guarded/denied/uncovered/new). Next build.");
    process.exit(2);
  }
  console.log([
    "seal assurance kit",
    "",
    "  seal verify <receipt.json>    verify a decision receipt (re-derive, trust nothing)",
    "  seal test   <server|profile>  MCP boundary conformance oracle      [coming]",
    "  seal scan   <tools> <policy>  MCP policy coverage auditor          [coming]",
  ].join("\n"));
  process.exit(cmd ? 2 : 0);
}

main().catch((e) => { console.error("ERR", e.message); process.exit(1); });
